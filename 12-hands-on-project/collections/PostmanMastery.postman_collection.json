{
  "info": {
    "_postman_id": "f3a1b2c4-6d7e-4a8b-9c0d-1e2f3a4b5c6d",
    "name": "Postman Mastery - Hands-On Project",
    "description": "A complete, runnable Postman collection built against https://postman-echo.com that demonstrates: variables, pre-request scripts, test assertions, request chaining, dynamic variables, authorization, and data-driven testing. Used throughout the Postman Mastery guide (see the repo README) as the practical companion to the written modules.\n\nSelect the **Dev** environment before running, then use the Collection Runner or Newman:\n\n```bash\nnewman run collections/PostmanMastery.postman_collection.json -e environments/dev.postman_environment.json -d data/users.csv\n```",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "00000000"
  },
  "item": [
    {
      "name": "01 - Fundamentals",
      "item": [
        {
          "name": "GET Echo with Query Params",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is below 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Query params are echoed back correctly\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.args.name).to.eql(\"Ada\");",
                  "    pm.expect(json.args.role).to.eql(\"admin\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/get?name=Ada&role=admin",
              "host": ["{{baseUrl}}"],
              "path": ["get"],
              "query": [
                { "key": "name", "value": "Ada" },
                { "key": "role", "value": "admin" }
              ]
            },
            "description": "Basic GET request demonstrating query params and environment variable usage."
          },
          "response": []
        },
        {
          "name": "POST Echo with JSON Body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Echoed JSON body matches what was sent\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.json.hello).to.eql(\"world\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type header was set to application/json\", function () {",
                  "    pm.expect(pm.request.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hello\": \"world\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": ["{{baseUrl}}"],
              "path": ["post"]
            },
            "description": "POST with a raw JSON body, demonstrating body-type handling and Content-Type auto-assignment."
          },
          "response": []
        }
      ],
      "description": "Basic request/response mechanics against postman-echo.com (Module 02)."
    },
    {
      "name": "02 - Authorization",
      "item": [
        {
          "name": "Basic Auth Example",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Authenticated successfully\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().authenticated).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "postman", "type": "string" },
                { "key": "password", "value": "password", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/basic-auth",
              "host": ["{{baseUrl}}"],
              "path": ["basic-auth"]
            },
            "description": "Demonstrates Basic Auth against postman-echo's dedicated test endpoint (Module 04)."
          },
          "response": []
        },
        {
          "name": "Bearer Token Example",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Authorization header was sent (Postman Echo redacts its value for security)\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.headers).to.have.property(\"authorization\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "{{demoBearerToken}}", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/headers",
              "host": ["{{baseUrl}}"],
              "path": ["headers"]
            },
            "description": "Demonstrates Bearer Token auth; token value comes from the environment variable demoBearerToken. Note: postman-echo.com redacts the actual Authorization header value in its response body as '******' for security, so the test only confirms the header was present, not its exact value."
          },
          "response": []
        }
      ],
      "description": "Authorization types in action (Module 04)."
    },
    {
      "name": "03 - Scripting and Dynamic Variables",
      "item": [
        {
          "name": "Create Fake User (Pre-request + Dynamic Vars)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Generate a unique request id and timestamp for correlation/tracing",
                  "pm.variables.set(\"requestId\", pm.variables.replaceIn(\"{{$guid}}\"));",
                  "pm.variables.set(\"requestTimestamp\", new Date().toISOString());",
                  "",
                  "console.log(\"Prepared request \" + pm.variables.get(\"requestId\") + \" at \" + pm.variables.get(\"requestTimestamp\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "",
                  "pm.test(\"Generated user has an email\", function () {",
                  "    pm.expect(json.json.email).to.be.a('string').and.to.include('@');",
                  "});",
                  "",
                  "pm.test(\"Request ID header round-tripped correctly\", function () {",
                  "    pm.expect(json.headers['x-trace-id']).to.eql(pm.variables.get(\"requestId\"));",
                  "});",
                  "",
                  "// Chain: store the generated user id for the next request in this folder",
                  "pm.collectionVariables.set(\"generatedUserId\", json.json.id);",
                  "pm.collectionVariables.set(\"generatedUserName\", json.json.name);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-Trace-Id", "value": "{{requestId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{$guid}}\",\n  \"name\": \"{{$randomFullName}}\",\n  \"email\": \"{{$randomEmail}}\",\n  \"createdAt\": \"{{requestTimestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": ["{{baseUrl}}"],
              "path": ["post"]
            },
            "description": "Demonstrates a pre-request script generating correlation data, dynamic variables building a fake-but-realistic payload, and a test script chaining data forward (Module 05)."
          },
          "response": []
        },
        {
          "name": "Fetch Generated User (Chained Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Chained userId query param matches the previously generated user\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.args.userId).to.eql(pm.collectionVariables.get(\"generatedUserId\"));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/get?userId={{generatedUserId}}&name={{generatedUserName}}",
              "host": ["{{baseUrl}}"],
              "path": ["get"],
              "query": [
                { "key": "userId", "value": "{{generatedUserId}}" },
                { "key": "name", "value": "{{generatedUserName}}" }
              ]
            },
            "description": "Uses the collection variables set by the previous request to demonstrate request chaining (Module 05.4). Must run AFTER 'Create Fake User' in sequence."
          },
          "response": []
        }
      ],
      "description": "Pre-request scripting, dynamic variables, and request chaining (Module 05)."
    },
    {
      "name": "04 - Data-Driven Testing",
      "item": [
        {
          "name": "Submit User From Data File",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Submitted name matches this iteration's data row\", function () {",
                  "    const json = pm.response.json();",
                  "    const expectedName = pm.iterationData.get(\"fullName\");",
                  "    pm.expect(json.json.name).to.eql(expectedName);",
                  "});",
                  "",
                  "pm.test(\"Submitted email matches this iteration's data row\", function () {",
                  "    const json = pm.response.json();",
                  "    const expectedEmail = pm.iterationData.get(\"email\");",
                  "    pm.expect(json.json.email).to.eql(expectedEmail);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{fullName}}\",\n  \"email\": \"{{email}}\",\n  \"role\": \"{{role}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": ["{{baseUrl}}"],
              "path": ["post"]
            },
            "description": "Designed to be run with data/users.csv supplying fullName/email/role per iteration (Module 07.2)."
          },
          "response": []
        }
      ],
      "description": "Demonstrates data-driven testing with an external CSV file (Module 07)."
    },
    {
      "name": "05 - Error Handling",
      "item": [
        {
          "name": "Simulate 500 Error",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 500\", function () {",
                  "    pm.response.to.have.status(500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/status/500",
              "host": ["{{baseUrl}}"],
              "path": ["status", "500"]
            },
            "description": "Demonstrates asserting on an expected error status code rather than assuming every response should be 200 (Module 05.2)."
          },
          "response": []
        }
      ],
      "description": "Testing non-happy-path responses."
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level pre-request script: runs before EVERY request in this collection.",
          "console.log(\"Running request: \" + pm.info.requestName + \" (iteration \" + (pm.info.iteration + 1) + \"/\" + pm.info.iterationCount + \")\");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Collection-level test script: runs after EVERY request in this collection.",
          "pm.test(\"[Global] Response time is below 5000ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});"
        ]
      }
    }
  ],
  "variable": [
    { "key": "generatedUserId", "value": "" },
    { "key": "generatedUserName", "value": "" }
  ]
}
